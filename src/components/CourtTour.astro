---
// Recorrido animado por scroll: mesa → pista → mesa → videomarcador → grada.
// Escena en SVG (sin dependencias); la cámara y los elementos se mueven con el progreso del scroll.
const { lang = 'es' } = Astro.props;
const en = lang === 'en';

const t = en
  ? {
      label: 'A match, from the table to the stands',
      sub: 'Scroll to follow a single basket through the whole platform.',
      steps: [
        { k: 'The scoring table', h: 'The starting players are picked here.', p: 'At the table, the scorer selects the three players who start for each team and the game begins.' },
        { k: 'On court', h: 'A shot, a basket.', p: 'Play starts and a player shoots. This is the moment the platform is waiting for.' },
        { k: 'Back at the table', h: 'The action is logged instantly.', p: 'One tap on +2 and the basket is saved to the match record, assigned to the right player.' },
        { k: 'The scoreboard', h: 'The big screen updates by itself.', p: 'The arena screen receives the action in real time: score, clock and the latest play.' },
        { k: 'In the stands', h: 'And the crowd follows it live.', p: 'From their phone, a fan sees the score and the play as soon as it is scored.' },
        { k: 'Your stream', h: 'The scoreboard, on your YouTube broadcast.', p: 'Add it as a widget in OBS with a single link, or switch it on over the broadcast inside the app itself.' },
        { k: 'At home', h: 'And whoever watches from home misses nothing.', p: 'The scoreboard sits on top of the live video, always in sync with the scoring table.' }
      ],
      obs: { sources: 'Sources', cam: 'Court camera', widget: 'LaRue3x3 scoreboard', logo: 'Logo', start: 'Start streaming', live: '● LIVE', url: 'Browser source · 1920×1080', scenes: 'Scenes', match: 'Match', yt: 'LIVE', yttitle: 'Court 1 · Final · Live' },
      aria: 'Animated illustration of a 3x3 court, from the scoring table to the stands',
      lineup: 'Starting line-up · pick 3', start: 'Start game', live: 'Game on', action: 'Scoring table',
      log: 'Game log', reb: 'Rebound', foul: 'Foul',
      logNew: '09:12  +2 · #7 Marc', log1: '08:48  Rebound · #11 Iván', log2: '10:00  Opening tip',
      board: { court: 'COURT 1', tourn: 'OPEN TOURNAMENT', a: 'BLUE', b: 'ORANGE', poss: 'SHOT CLOCK', fouls: 'FOULS  2 — 1', play: '+2 · #7 MARC · BLUE' },
      phone: { live: '● LIVE', a: 'BLU', b: 'ORA', n: '09:12  +2 · #7 Marc', o1: '08:48  Rebound · #11', o2: '10:00  Opening tip' },
      table: 'LARUE3x3'
    }
  : {
      label: 'Un partido, de la mesa a la grada',
      sub: 'Haz scroll y sigue una sola canasta a través de toda la plataforma.',
      steps: [
        { k: 'La mesa de anotación', h: 'Aquí se eligen los jugadores iniciales.', p: 'En la mesa, el anotador selecciona a los tres jugadores que saldrán de cada equipo y empieza el partido.' },
        { k: 'En pista', h: 'Un tiro, una canasta.', p: 'Arranca el juego y un jugador lanza. Es el momento que la plataforma está esperando.' },
        { k: 'De vuelta en la mesa', h: 'La acción se registra al instante.', p: 'Un toque en +2 y la canasta queda en el acta del partido, asignada al jugador que la anotó.' },
        { k: 'El videomarcador', h: 'La pantalla grande se actualiza sola.', p: 'La pantalla del pabellón recibe la acción en tiempo real: marcador, reloj y última jugada.' },
        { k: 'En la grada', h: 'Y el público lo sigue en directo.', p: 'Desde el móvil, un aficionado ve el marcador y la jugada nada más anotarse.' },
        { k: 'Tu retransmisión', h: 'El marcador, en tu directo de YouTube.', p: 'Añádelo como widget en OBS con un solo enlace, o actívalo sobre la retransmisión dentro de la propia app.' },
        { k: 'En casa', h: 'Y quien lo ve desde casa no se pierde nada.', p: 'El marcador aparece sobre el vídeo en directo, siempre sincronizado con la mesa.' }
      ],
      obs: { sources: 'Fuentes', cam: 'Cámara pista', widget: 'Marcador LaRue3x3', logo: 'Logo', start: 'Iniciar transmisión', live: '● EN DIRECTO', url: 'Fuente de navegador · 1920×1080', scenes: 'Escenas', match: 'Partido', yt: 'EN DIRECTO', yttitle: 'Pista 1 · Final · En directo' },
      aria: 'Ilustración animada de una cancha de 3x3, desde la mesa de anotación hasta la grada',
      lineup: 'Quinteto inicial · elige 3', start: 'Empezar partido', live: 'Partido en juego', action: 'Mesa de anotación',
      log: 'Registro', reb: 'Rebote', foul: 'Falta',
      logNew: '09:12  +2 · #7 Marc', log1: '08:48  Rebote · #11 Iván', log2: '10:00  Salto inicial',
      board: { court: 'PISTA 1', tourn: 'TORNEO ABIERTO', a: 'AZUL', b: 'NARANJA', poss: 'POSESIÓN', fouls: 'FALTAS  2 — 1', play: '+2 · #7 MARC · AZUL' },
      phone: { live: '● EN DIRECTO', a: 'AZU', b: 'NAR', n: '09:12  +2 · #7 Marc', o1: '08:48  Rebote · #11', o2: '10:00  Salto inicial' },
      table: 'LARUE3x3'
    };
// Alineación del tablet: el título de la pantalla cambia de idioma, los dorsales no
const lineup = [['4', 'Pau'], ['7', 'Marc'], ['9', 'Leo'], ['11', 'Iván']];
const adX = [60, 340, 620, 900, 1180, 1460];
// Jugadores en pista (de más lejos a más cerca). 'sh' es el tirador y 'd' su defensor
const figs = [
  { k: 'o1', x: 470, y: 560, s: 1.1, col: '#a84d20', skin: '#a97352' },
  { k: 'b2', x: 805, y: 565, s: 1.16, col: '#2a4a96', skin: '#d5a07a' },
  { k: 'b3', x: 395, y: 610, s: 1.32, col: '#2a4a96', skin: '#7c5038' },
  { k: 'd', x: 610, y: 628, s: 1.42, col: '#a84d20', skin: '#c99774' },
  { k: 'o3', x: 745, y: 655, s: 1.48, col: '#a84d20', skin: '#8a5a3f' },
  { k: 'sh', x: 560, y: 655, s: 1.55, col: '#2a4a96', skin: '#d5a07a' }
];
---

<section class="tour" id={en ? 'match' : 'partido'} data-tour>
  <h2 class="l-h2 reveal-up">{t.label}</h2>
  <p class="l-sub reveal-up">{t.sub}</p>

  <div class="tour-track">
    <div class="tour-sticky">
      <div class="tour-stage">
        <svg class="tour-svg" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="img" aria-label={t.aria} data-svg>
          <defs>
            <!-- ambiente -->
            <linearGradient id="ct-stands" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0d0b1f"/><stop offset="1" stop-color="#1d1a3b"/>
            </linearGradient>
            <linearGradient id="ct-crowdfade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#05040d" stop-opacity=".78"/>
              <stop offset=".55" stop-color="#0b0a1c" stop-opacity=".25"/>
              <stop offset="1" stop-color="#0b0a1c" stop-opacity=".55"/>
            </linearGradient>
            <linearGradient id="ct-floor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#171a30"/><stop offset=".35" stop-color="#252a47"/><stop offset="1" stop-color="#1a1d35"/>
            </linearGradient>
            <linearGradient id="ct-paint" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3a4268"/><stop offset=".5" stop-color="#2f3659"/><stop offset="1" stop-color="#262c4c"/>
            </linearGradient>
            <radialGradient id="ct-spot" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#9fb0ff" stop-opacity=".22"/><stop offset="1" stop-color="#9fb0ff" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="ct-ledglow" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#5b7cff" stop-opacity=".38"/><stop offset=".6" stop-color="#5b7cff" stop-opacity=".1"/><stop offset="1" stop-color="#5b7cff" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="ct-tabglow" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#ff8a4c" stop-opacity=".22"/><stop offset="1" stop-color="#ff8a4c" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="ct-shadow" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#000" stop-opacity=".55"/><stop offset="1" stop-color="#000" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="ct-vig" cx=".5" cy=".5" r=".75">
              <stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".55"/>
            </radialGradient>
            <radialGradient id="ct-ball" cx=".38" cy=".34" r=".75">
              <stop offset="0" stop-color="#f08a3e"/><stop offset=".6" stop-color="#c4561b"/><stop offset="1" stop-color="#7f3510"/>
            </radialGradient>
            <linearGradient id="ct-shade" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity=".2"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".55"/>
            </linearGradient>
            <linearGradient id="ct-skin" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity=".12"/><stop offset="1" stop-color="#000" stop-opacity=".3"/>
            </linearGradient>
            <linearGradient id="ct-glass" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".5" stop-color="#fff" stop-opacity=".05"/><stop offset="1" stop-color="#fff" stop-opacity=".14"/>
            </linearGradient>
            <linearGradient id="ct-desk" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2c2652"/><stop offset="1" stop-color="#15122e"/>
            </linearGradient>
            <pattern id="ct-scan" width="4" height="4" patternUnits="userSpaceOnUse"><rect width="4" height="1.2" fill="#000" opacity=".28"/></pattern>

            <!-- jugador de pie: pies en (0,0), ~100 de alto, color de equipo con currentColor, piel con --skin -->
            <g id="ct-arm-l">
              <path d="M-11 -85L-15.5 -63L-14.6 -52L-10.6 -53L-9.4 -64L-7.4 -84Z" fill="var(--skin,#c99774)"/>
              <path d="M-11 -85L-15.5 -63L-14.6 -52L-10.6 -53L-9.4 -64L-7.4 -84Z" fill="url(#ct-skin)"/>
            </g>
            <g id="ct-body">
              <ellipse cx="0" cy="1" rx="19" ry="4.6" fill="url(#ct-shadow)"/>
              <path d="M-9.4 -52L-2.4 -52L-3.4 -6L-8.8 -6Z" fill="var(--skin,#c99774)"/>
              <path d="M2.4 -52L9.4 -52L8.8 -6L3.4 -6Z" fill="var(--skin,#c99774)"/>
              <path d="M-9.4 -52L-2.4 -52L-3.4 -6L-8.8 -6ZM2.4 -52L9.4 -52L8.8 -6L3.4 -6Z" fill="url(#ct-skin)"/>
              <path d="M-9.6 -6L-3 -6L-2.6 0L-10.4 0Z" fill="#14141c"/>
              <path d="M3 -6L9.6 -6L10.4 0L2.6 0Z" fill="#14141c"/>
              <path d="M-11 -60L11 -60L12 -39L1.6 -39L0 -47L-1.6 -39L-12 -39Z" fill="currentColor"/>
              <path d="M-11 -60L11 -60L12 -39L1.6 -39L0 -47L-1.6 -39L-12 -39Z" fill="url(#ct-shade)"/>
              <path d="M-11.4 -60Q-12.6 -80 -8 -86L8 -86Q12.6 -80 11.4 -60Z" fill="currentColor"/>
              <path d="M-11.4 -60Q-12.6 -80 -8 -86L8 -86Q12.6 -80 11.4 -60Z" fill="url(#ct-shade)"/>
              <rect x="-2.6" y="-91" width="5.2" height="6" rx="2" fill="var(--skin,#c99774)"/>
              <ellipse cx="0" cy="-96" rx="5.3" ry="6.3" fill="var(--skin,#c99774)"/>
              <path d="M-5.6 -96Q-6 -103 0 -102.6Q6 -103 5.6 -96Q3 -99 0 -98.6Q-3 -99 -5.6 -96Z" fill="#1b1410"/>
            </g>
            <g id="ct-player">
              <use href="#ct-body"/>
              <use href="#ct-arm-l"/>
              <use href="#ct-arm-l" transform="scale(-1 1)"/>
            </g>
            <g id="ct-player-up">
              <use href="#ct-body"/>
              <g transform="rotate(150 -9 -83)"><use href="#ct-arm-l"/></g>
              <g transform="rotate(-150 9 -83)"><use href="#ct-arm-l" transform="scale(-1 1)"/></g>
            </g>
            <pattern id="ct-grainpat" data-k="grainPat" width="256" height="256" patternUnits="userSpaceOnUse"><image href="/larue/tour/grain.webp" width="256" height="256"/></pattern>
            <linearGradient id="ct-grade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3a52c8" stop-opacity=".55"/><stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#e0732a" stop-opacity=".35"/>
            </linearGradient>
            <radialGradient id="ct-hoopglow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffc58a" stop-opacity=".9"/><stop offset="1" stop-color="#ffc58a" stop-opacity="0"/></radialGradient>
            <clipPath id="ct-clip-obs"><rect x="10" y="30" width="420" height="237"/></clipPath>
            <clipPath id="ct-clip-tv"><rect x="2860" y="230" width="640" height="360"/></clipPath>
            <radialGradient id="ct-phoneglow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#9db4ff" stop-opacity=".42"/><stop offset="1" stop-color="#9db4ff" stop-opacity="0"/></radialGradient>
            <radialGradient id="ct-tv" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#6f8cff" stop-opacity=".3"/><stop offset="1" stop-color="#6f8cff" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="ct-lamp" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#ffb066" stop-opacity=".28"/><stop offset="1" stop-color="#ffb066" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="ct-wall" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#171210"/><stop offset="1" stop-color="#0d0a09"/>
            </linearGradient>
            <!-- marcador superpuesto en la retransmisión, con la estética de la app (160×36) -->
            <linearGradient id="ct-bugbg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1b1f26"/><stop offset="1" stop-color="#0f1217"/></linearGradient>
            <!-- marcador del directo (overlay de la app, 1024×67) -->
            <g id="ct-bug" font-family="'Barlow Condensed','Arial Narrow',Arial,sans-serif" font-weight="600">
              <rect x="2" y="6" width="1020" height="64" rx="12" fill="#000" fill-opacity=".35"/>
              <rect width="1024" height="67" rx="10.24" fill="url(#ct-bugbg)"/>
              <rect x="432" width="160" height="67" fill="#ea580c"/>
              <circle cx="38.5" cy="33.5" r="24.5" fill="#7c3aed" stroke="#fff" stroke-width="2.4"/>
              <text x="38.5" y="41" font-size="22" font-weight="700" fill="#fff" text-anchor="middle">CJ</text>
              <text x="76" y="29" font-size="20.48" letter-spacing=".61" fill="#fff">CLUB JOVENTUT 3X3</text>
              <circle cx="80.50" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="93.15" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="105.80" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="118.45" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="131.10" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="143.75" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/>
              <rect x="349" y="5" width="69" height="56" rx="6.4" fill="#fff" fill-opacity=".08"/>
              <text x="383.5" y="49" font-size="46.08" fill="#fff" text-anchor="middle">2</text>
              <text x="512" y="45" font-size="38.4" fill="#fff" text-anchor="middle" data-k="clockBug">09:54</text>
              <rect x="606" y="5" width="69" height="56" rx="6.4" fill="#fff" fill-opacity=".08"/>
              <text x="640.5" y="49" font-size="46.08" fill="#fff" text-anchor="middle">0</text>
              <text x="948" y="29" font-size="20.48" letter-spacing=".61" fill="#fff" text-anchor="end">FENERBAHÇE BEKO 3X3</text>
              <circle cx="943.50" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="930.85" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="918.20" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="905.55" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="892.90" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/><circle cx="880.25" cy="46.5" r="4.5" fill="#fff" fill-opacity=".22"/>
              <circle cx="985.5" cy="33.5" r="24.5" fill="#dc2626" stroke="#fff" stroke-width="2.4"/>
              <text x="985.5" y="41" font-size="22" font-weight="700" fill="#fff" text-anchor="middle">FB</text>
            </g>
            <!-- balón -->
            <g id="ct-bball">
              <circle r="11" fill="url(#ct-ball)"/>
              <path d="M-11 0H11M0 -11V11M-7.8 -7.8Q0 0 -7.8 7.8M7.8 -7.8Q0 0 7.8 7.8" stroke="#1b0d05" stroke-opacity=".55" stroke-width=".9" fill="none"/>
            </g>
          </defs>

          <g data-k="world">
            <!-- ═ GRADA ═ -->
            <g id="ct-venue">
            <rect x="0" y="0" width="1600" height="346" fill="#0a0916"/>
            <g data-k="crowd"><image href="/larue/tour/crowd.webp" x="0" y="-6" width="1600" height="346" preserveAspectRatio="none"/><image data-k="crowdB" href="/larue/tour/crowd-b.webp" x="0" y="-6" width="1600" height="346" preserveAspectRatio="none" style="opacity:0"/></g>
            <g fill="#cfd6ff" opacity=".35">
              <circle cx="120" cy="18" r="3"/><circle cx="420" cy="12" r="2.4"/><circle cx="760" cy="20" r="3.2"/><circle cx="1120" cy="14" r="2.6"/><circle cx="1480" cy="18" r="3"/>
            </g>

            <!-- videomarcador -->
            <g data-k="flashes"><circle cx="180" cy="150" r="3.2" fill="#fff" style="opacity:0"/><circle cx="330" cy="210" r="2.6" fill="#fff" style="opacity:0"/><circle cx="520" cy="120" r="3" fill="#fff" style="opacity:0"/><circle cx="700" cy="230" r="2.4" fill="#fff" style="opacity:0"/><circle cx="1040" cy="70" r="2.8" fill="#fff" style="opacity:0"/><circle cx="1230" cy="200" r="3.2" fill="#fff" style="opacity:0"/><circle cx="1380" cy="140" r="2.6" fill="#fff" style="opacity:0"/><circle cx="1500" cy="230" r="3" fill="#fff" style="opacity:0"/><circle cx="250" cy="90" r="2.4" fill="#fff" style="opacity:0"/><circle cx="1430" cy="60" r="2.2" fill="#fff" style="opacity:0"/><circle cx="90" cy="230" r="2.8" fill="#fff" style="opacity:0"/><circle cx="940" cy="28" r="2.4" fill="#fff" style="opacity:0"/></g>
            <rect x="770" y="20" width="560" height="310" fill="url(#ct-ledglow)"/>
            <g transform="translate(814 40)">
              <rect x="-6" y="-6" width="472" height="271" rx="3" fill="#050507"/>
              <g transform="scale(.359375)">
                <image href="/larue/pantalla-poster.webp" width="1280" height="720"/>
                <rect x="500" y="300" width="282" height="100" fill="#171717"/>
                <text x="641" y="382" font-size="88" font-weight="900" fill="#fff" text-anchor="middle" font-family="'Arial Black','Helvetica Neue',Inter,system-ui,sans-serif" data-k="clockWall">10:00</text>
                <rect x="1130" y="30" width="124" height="32" rx="16" fill="#3a2412"/>
                <text x="1192" y="52" font-size="15" font-weight="700" fill="#fdba74" text-anchor="middle" font-family="Inter,system-ui,sans-serif" letter-spacing=".5" data-k="wallState">RELOJ PARADO</text>
                <g data-k="boardPost" style="opacity:0" font-family="'Arial Black','Helvetica Neue',Inter,system-ui,sans-serif">
                  <rect x="190" y="350" width="140" height="140" fill="#171717"/>
                  <g data-k="pop"><text x="256" y="474" font-size="150" font-weight="900" fill="#fff" text-anchor="middle">2</text></g>
                  <rect x="32" y="646" width="1216" height="54" rx="12" fill="#242424"/>
                  <text x="640" y="682" font-size="26" font-weight="600" fill="#fff" text-anchor="middle" font-family="Inter,system-ui,sans-serif"><tspan fill="#ff7a35" font-weight="800">+2</tspan>  ·  Jamal Murray  ·  Club Joventut 3x3</text>
                </g>
              </g>
              <rect width="460" height="259" fill="url(#ct-scan)" opacity=".28"/>
              <rect data-k="boardFlash" width="460" height="259" fill="#fff" style="opacity:0"/>
            </g>

            <!-- aficionado con el móvil -->
            <g data-k="fan">
              <path d="M376 304Q378 246 408 238L432 238Q452 246 454 304Z" fill="#2c211d"/>
              <path d="M376 304Q378 246 408 238L432 238Q452 246 454 304Z" fill="url(#ct-shade)"/>
              <rect x="412" y="222" width="16" height="18" rx="5" fill="#5a4034"/>
              <ellipse cx="420" cy="206" rx="12.5" ry="14.5" fill="#6e5042"/>
              <ellipse cx="428" cy="208" rx="8" ry="12" fill="url(#ct-phoneglow)"/>
              <ellipse cx="420" cy="206" rx="12.5" ry="14.5" fill="url(#ct-skin)"/>
              <path d="M407 204Q406 189 420 189Q434 189 433 204Q428 197 420 197Q412 197 407 204Z" fill="#1d1511"/>
              <!-- móvil -->
              <rect x="451" y="189" width="60" height="120" rx="9" fill="#08080c"/>
              <rect x="451.6" y="189.6" width="58.8" height="118.8" rx="8.6" fill="none" stroke="#4a4a64" stroke-width="1"/>
              <g transform="translate(455 193) scale(.1333)" font-family="Inter,system-ui,sans-serif">
                <image href="/larue/tour/movil-resumen.webp" width="390" height="844"/>
                <image data-k="phoneJug" href="/larue/tour/movil-jugadores.webp" width="390" height="844" style="opacity:0"/>
                <g data-k="phoneMap" style="opacity:0">
                  <image href="/larue/tour/movil-mapa.webp" width="390" height="844"/>
                  <circle data-k="mapCover" cx="147" cy="601" r="9" fill="#faf6ee"/>
                  <circle data-k="mapRing" cx="147" cy="601" r="12" fill="none" stroke="#2563eb" stroke-width="3" style="opacity:0;transform-box:fill-box;transform-origin:center"/>
