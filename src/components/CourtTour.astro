              <path d="M3156 666Q3154 640 3180 640Q3206 640 3204 666Q3194 650 3180 650Q3166 650 3156 666Z" fill="#14100e"/>
              <path d="M3155 676Q3156 654 3180 654" fill="none" stroke="#6f8cff" stroke-opacity=".45" stroke-width="2.4" stroke-linecap="round"/>
              <path d="M3205 676Q3204 654 3180 654" fill="none" stroke="#6f8cff" stroke-opacity=".45" stroke-width="2.4" stroke-linecap="round"/>
            </g>
            <rect x="2900" y="788" width="560" height="84" rx="22" fill="#2b2220"/>
            <rect x="2900" y="788" width="560" height="84" rx="22" fill="url(#ct-shade)" opacity=".5"/>
            </g>
          </g>

          <rect width="1600" height="900" fill="url(#ct-grade)" opacity=".5" pointer-events="none"/>
          <rect width="1600" height="900" fill="url(#ct-vig)" pointer-events="none"/>
          <rect width="1600" height="900" fill="url(#ct-grainpat)" opacity=".05" pointer-events="none"/>
          <rect data-k="dip" width="1600" height="900" fill="#000" style="opacity:0" pointer-events="none"/>
        </svg>
      </div>

      <div class="tour-caps" aria-live="polite">
        {t.steps.map((s, i) => (
          <div class={`tour-cap${i === 0 ? ' is-active' : ''}`} data-cap>
            <span class="story-kicker">{String(i + 1).padStart(2, '0')} · {s.k}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
      <div class="tour-dots" aria-hidden="true">
        {t.steps.map((_, i) => (<span class={i === 0 ? 'is-active' : ''} data-dot></span>))}
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const track = root.querySelector<HTMLElement>('.tour-track')!;
    const sticky = root.querySelector<HTMLElement>('.tour-sticky')!;
    const $ = (k: string) => root.querySelector<SVGElement>(`[data-k="${k}"]`)!;
    const caps = Array.from(root.querySelectorAll('[data-cap]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));

    const el = {
      world: $('world'), tabPost: $('tabPost'), titulares: $('titulares'), mesaLayer: $('mesaLayer'), cntL: $('cntL'), cntR: $('cntR'),
      ticks: [0, 1, 2, 3, 4, 5].map(i => $('tick' + i)),
      clockTab: $('clockTab'), clockWall: $('clockWall'), wallState: $('wallState'), clockPhone: $('clockPhone'), clockBug: $('clockBug'),
      phoneScore: $('phoneScore'), phoneJug: $('phoneJug'), phoneMap: $('phoneMap'), mapCover: $('mapCover'), mapRing: $('mapRing'), phoneCro: $('phoneCro'), phoneRow: $('phoneRow'),
      playHl: $('playHl'), plusHl: $('plusHl'), ptr: $('ptr'), ring: $('ring'),
      ball: $('ball'), net: $('net'), rim: $('rim'), hoopGlow: $('hoopGlow'),
      boardPost: $('boardPost'), boardFlash: $('boardFlash'), pop: $('pop'),
      bugObs: $('bugObs'), eye: $('eye'), obsLive: $('obsLive'),
      crowd: $('crowd'), crowdB: $('crowdB'), flashes: Array.from($('flashes').children) as SVGElement[], dip: $('dip'),
      scL: $('scL'), scR: $('scR'), obsScene: $('obsScene'), homeScene: $('homeScene')
    };

    // ── Utilidades
    const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const sm = (x: number) => x * x * x * (x * (x * 6 - 15) + 10); // smootherstep: arranque y parada más suaves
    const seg = (p: number, a: number, b: number) => sm(clamp((p - a) / (b - a)));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const op = (e: SVGElement, v: number) => { const t = String(Math.round(v * 100) / 100); if (e.style.opacity !== t) e.style.opacity = t; };
    const txt = (e: SVGElement, v: string) => { if (e.textContent !== v) e.textContent = v; };
    const bump = (p: number, c: number, w: number) => Math.max(0, 1 - Math.abs(p - c) / w);
    const cache = new WeakMap<Element, string>();
    const tf = (e: Element, v: string) => { if (cache.get(e) !== v) { cache.set(e, v); e.setAttribute('transform', v); } };
    const showEl = (e: SVGElement, on: boolean) => { const d = on ? '' : 'none'; if (e.style.display !== d) e.style.display = d; };

    // ── Jugadores articulados
    type Fig = { g: SVGElement; B: SVGElement; LL: SVGElement; LS: SVGElement; RL: SVGElement; RS: SVGElement; AL: SVGElement; FL: SVGElement; AR: SVGElement; FR: SVGElement; x: number; y: number; s: number };
    const mk = (k: string, x: number, y: number, s: number): Fig => ({
      g: $(k), B: $(k + 'B'), LL: $(k + 'LL'), LS: $(k + 'LS'), RL: $(k + 'RL'), RS: $(k + 'RS'),
      AL: $(k + 'AL'), FL: $(k + 'FL'), AR: $(k + 'AR'), FR: $(k + 'FR'), x, y, s
    });
    const F = {
      sh: mk('sh', 560, 655, 1.55), d: mk('d', 610, 628, 1.42), b2: mk('b2', 805, 565, 1.16),
      b3: mk('b3', 395, 610, 1.32), o1: mk('o1', 470, 560, 1.1), o3: mk('o3', 745, 655, 1.48)
    };
    // Poses de brazo: [hombro, codo] en grados. Rotación horaria desde "colgando"
    const ARM = { idle: [8, 16], hold: [10, 195], raise: [120, 100], ext: [165, 25], up: [168, 14], guard: [24, 46] };
    // posa una figura: c = flexión de piernas (0-1), jy = altura de salto, th/ph = hombro/codo, dx/dy/s = posición
    function pose(f: Fig, o: { c?: number; jy?: number; th: number; ph: number; x?: number; y?: number; lean?: number }) {
      const c = o.c ?? 0, jy = o.jy ?? 0;
      const t = 50 * c, rad = Math.PI / 180;
      const drop = 48 - (24 * Math.cos(t * rad) + 24 * Math.cos(t * 0.6 * rad));
      tf(f.B, `translate(0 ${(drop - jy).toFixed(2)})`);
      tf(f.LL, `translate(-4.6 -50) rotate(${t.toFixed(1)})`);
      tf(f.LS, `translate(0 24) rotate(${(-1.6 * t).toFixed(1)})`);
      tf(f.RL, `translate(4.6 -50) rotate(${(-t).toFixed(1)})`);
      tf(f.RS, `translate(0 24) rotate(${(1.6 * t).toFixed(1)})`);
      tf(f.AL, `translate(-11.4 -83) rotate(${o.th.toFixed(1)})`);
      tf(f.FL, `translate(0 14.5) rotate(${o.ph.toFixed(1)})`);
      tf(f.AR, `translate(11.4 -83) rotate(${(-o.th).toFixed(1)})`);
      tf(f.FR, `translate(0 14.5) rotate(${(-o.ph).toFixed(1)})`);
      tf(f.g, `translate(${(o.x ?? f.x).toFixed(2)} ${(o.y ?? f.y).toFixed(2)}) scale(${f.s})`);
      return drop - jy;
    }
    const mixArm = (a: number[], b: number[], e: number) => [lerp(a[0], b[0], e), lerp(a[1], b[1], e)];
    // altura de las manos (coordenada local) para sujetar el balón
    const handY = (th: number, ph: number) => -83 + 15 * Math.cos(th * Math.PI / 180) + 14.5 * Math.cos((th + ph) * Math.PI / 180);

    // ── Cámara
    const POSES: Record<string, { x: number; y: number; z: number }> = {
      wide: { x: 800, y: 450, z: 1 }, table: { x: 1215, y: 520, z: 3.3 }, court: { x: 620, y: 520, z: 1.7 },
      board: { x: 1044, y: 170, z: 2.8 }, stands: { x: 481, y: 250, z: 5.1 },
      obs: { x: 2020, y: 430, z: 2 }, home: { x: 3180, y: 530, z: 1.3 }
    };
    const MOVES: [number, number, string][] = [[.03, .10, 'table'], [.21, .27, 'court'], [.50, .56, 'table'], [.64, .70, 'board'], [.73, .79, 'stands']];
    const CUTS: [number, number, string][] = [[.86, .88, 'obs'], [.935, .955, 'home']];
    const BOUNDS = [0, .21, .50, .64, .73, .87, .945];

    // Cursor táctil: ventanas de aparición y recorrido
    const PATHS: { w: [number, number, number, number]; pts: [number, number, number][] }[] = [
      { w: [.085, .10, .205, .22], pts: [[.085, 1190, 470], [.105, 1125.8, 491], [.12, 1172.4, 491], [.135, 1125.8, 501.2], [.15, 1222.4, 491], [.165, 1269, 491], [.18, 1222.4, 501.2], [.195, 1215.2, 521.7]] },
      { w: [.52, .54, .60, .62], pts: [[.52, 1262, 566], [.575, 1203.3, 517.5]] },
      { w: [.88, .89, .93, .945], pts: [[.88, 2200, 470], [.90, 2312, 312], [.92, 2240, 562]] }
    ];
    const TICKS = [.105, .12, .135, .15, .165, .18];
    const TAPS = [...TICKS, .195, .575, .90, .92];

    // Tiro: P .31 → .46. Fases (sp 0-1) definidas en shotState()
    const SHOT0 = .31, SHOT_LEN = .15;
    const RIM = { x: 620, y: 360 };
    function shotState(sp: number) {
      const crouch = seg(sp, .08, .27) * (1 - seg(sp, .27, .38)) + .5 * Math.sin(Math.PI * clamp((sp - .70) / .14));
      const jy = sp > .32 && sp < .72 ? 36 * Math.sin(Math.PI * clamp((sp - .32) / .40)) : 0;
      let arm = ARM.idle;
      if (sp < .08) arm = mixArm(ARM.idle, ARM.hold, seg(sp, 0, .08));
      else if (sp < .28) arm = ARM.hold;
      else if (sp < .42) arm = mixArm(ARM.hold, ARM.raise, seg(sp, .28, .42));
      else if (sp < .50) arm = mixArm(ARM.raise, ARM.ext, seg(sp, .42, .50));
      else if (sp < .72) arm = [ARM.ext[0], ARM.ext[1] + 20 * seg(sp, .50, .54) * (1 - seg(sp, .54, .64))];
      else arm = mixArm(ARM.ext, ARM.idle, seg(sp, .72, .88));
      return { c: crouch, jy, th: arm[0], ph: arm[1] };
    }
    const holdPos = (sp: number, dribbleX: number, dribbleY: number) => {
      const st = shotState(sp), body = 48 - (24 * Math.cos(50 * st.c * Math.PI / 180) + 24 * Math.cos(30 * st.c * Math.PI / 180)) - st.jy;
      const hy = handY(st.th, st.ph) - 4 + body;
      const e = seg(sp, 0, .08);
      return { x: lerp(dribbleX, F.sh.x + 1, e), y: lerp(dribbleY, F.sh.y + F.sh.s * hy, e) };
    };

    let lastClock = '', lastBlur = -1, frame = 0;
    function render(P: number, T: number) {
      // ── cámara: planos con desplazamiento suave + cortes con fundido a negro
      let c = { ...POSES.wide };
      for (const [a, b, k] of MOVES) {
        const e = seg(P, a, b);
        if (e > 0) { const q = POSES[k]; c = { x: lerp(c.x, q.x, e), y: lerp(c.y, q.y, e), z: c.z * Math.pow(q.z / c.z, e) }; }
      }
      let dip = 0;
      for (const [a, b, k] of CUTS) {
        if (P < a) continue;
        const u = clamp((P - a) / (b - a)), q = POSES[k];
        if (u >= .5) c = { x: q.x, y: q.y, z: q.z * (.9 + .1 * seg(u, .5, 1)) };
        dip = Math.max(dip, P < b ? Math.pow(Math.sin(Math.PI * u), 1.4) : 0);
      }
      // intro: empuje lento hacia dentro; golpe de cámara al entrar el tiro; cámara en mano
      const sp = (P - SHOT0) / SHOT_LEN;
      c.z *= 1 + .05 * (1 - seg(P, 0, .03)) * 0 + .035 * bump(sp, .82, .1);
      const hx = 0, hy = 0;
      tf(el.world, `translate(800 450) scale(${c.z.toFixed(4)}) translate(${(-c.x - hx).toFixed(2)} ${(-c.y - hy).toFixed(2)})`);
      op(el.dip, dip * .96);
      showEl(el.obsScene, P >= .855 && P < .965); showEl(el.homeScene, P >= .93);
      // profundidad de campo: la grada se desenfoca al acercarse a las pantallas
      const dof = Math.round(clamp((c.z - 1.3) / 2.2) * 20) / 20;
      if (dof !== lastBlur) { lastBlur = dof; op(el.crowdB, dof); showEl(el.crowdB, dof > 0); }

      // ── tablet: selección, inicio y, tras el tiro, el 2-0
      TICKS.forEach((t, i) => op(el.ticks[i], seg(P, t, t + .008)));
      txt(el.cntL, `CLUB JOVENTUT 3X3 · ${TICKS.slice(0, 3).filter(t => P >= t).length}/3`);
      txt(el.cntR, `FENERBAHÇE BEKO 3X3 · ${TICKS.slice(3).filter(t => P >= t).length}/3`);
      op(el.titulares, 1 - seg(P, .205, .22)); op(el.mesaLayer, seg(P, .205, .22));
      op(el.playHl, bump(P, .197, .014) * .45);
      op(el.tabPost, seg(P, .585, .60));
      op(el.plusHl, bump(P, .578, .014) * .5);

      // ── cursor táctil
      let pv = 0, px = 0, py = 0;
      PATHS.forEach(path => {
        const [a, b, c2, d] = path.w;
        const o = seg(P, a, b) * (1 - seg(P, c2, d));
        if (o <= 0) return;
        pv = Math.max(pv, o);
        const pts = path.pts;
        let i = 0; while (i < pts.length - 2 && P > pts[i + 1][0]) i++;
        const [t0, x0, y0] = pts[i], [t1, x1, y1] = pts[Math.min(i + 1, pts.length - 1)];
        const e = t1 === t0 ? 1 : seg(P, t0, t1);
        px = x0 + (x1 - x0) * e; py = y0 + (y1 - y0) * e;
      });
      op(el.ptr, pv); tf(el.ptr, `translate(${px.toFixed(2)} ${py.toFixed(2)})`);
      let ring = 0, rs = .4, tapN = 0;
      TAPS.forEach(t => { const d = (P - t) / .014; if (d >= 0 && d < 1) { ring = (1 - d) * .8; rs = .4 + d * 1.5; } tapN = Math.max(tapN, bump(P, t + .004, .008)); });
      op(el.ring, ring); tf(el.ring, `scale(${rs.toFixed(3)})`);
      // los anotadores se inclinan un poco al tocar
      tf(el.scL, `translate(-30 ${(1.8 * tapN).toFixed(2)})`);
      tf(el.scR, `translate(40 ${(1.2 * tapN).toFixed(2)})`);

      // ── OBS
      const eyeOn = seg(P, .90, .91);
      op(el.eye, eyeOn); op(el.bugObs, eyeOn);
      op(el.obsLive, seg(P, .92, .93));

      // ── pista: el tirador y el resto de jugadores
      const st = shotState(clamp(sp, 0, 1.2));
      const spc = clamp(sp);
      // compañeros y rivales: movimiento de reposo y desmarques
      const sway = (a: number, ph: number, sp2 = 1) => a * Math.sin(T * sp2 + ph);
      pose(F.o1, { c: .14 + .07 * Math.sin(T * 1.7), th: ARM.guard[0], ph: ARM.guard[1], x: F.o1.x + sway(9, 0, .8), y: F.o1.y });
      pose(F.o3, { c: .14 + .06 * Math.sin(T * 1.5 + 2), th: ARM.guard[0], ph: ARM.guard[1], x: F.o3.x + sway(8, 1.5, .7) });
      pose(F.b2, { c: .06 + .04 * Math.sin(T * 1.3), th: ARM.idle[0] + 10 * Math.sin(T), ph: ARM.idle[1], x: F.b2.x + sway(5, 3, .6) });
      const run = seg(spc, .05, .55), stepping = run > 0 && run < 1 ? Math.abs(Math.sin(T * 7)) : 0;
      pose(F.b3, { c: .06 + .1 * stepping, jy: 3 * stepping, th: ARM.idle[0], ph: ARM.idle[1], x: F.b3.x + 70 * run, y: F.b3.y - 14 * run });
      // defensor: postura baja, brazos arriba tarde y salto a destiempo
      const dArms = mixArm(ARM.guard, ARM.up, seg(spc, .28, .46));
      const dJump = spc > .44 && spc < .74 ? 24 * Math.sin(Math.PI * clamp((spc - .44) / .30)) : 0;
      pose(F.d, { c: (.2 + .06 * Math.sin(T * 2)) * (1 - seg(spc, .44, .50)), jy: dJump, th: dArms[0], ph: dArms[1], x: F.d.x + sway(5, 2, 1.1) * (1 - seg(spc, .3, .46)) });
      // tirador
      const body = pose(F.sh, { c: st.c, jy: st.jy, th: st.th, ph: st.ph, x: F.sh.x + 3 * Math.sin(T * 1.2) * (1 - seg(P, SHOT0 - .04, SHOT0)) });
      void body;

      // balón: bote → recogida → tiro → aro → rebotes
      let bx = 0, by = 0, bs = 1.15, bo = 1;
      if (P < SHOT0 - .02) { bo = 0; }
      const handX = F.sh.x + 14 * F.sh.s * .6, floorY = F.sh.y;
      if (P >= SHOT0 - .02 && sp < 0) { bx = handX; by = floorY - F.sh.s * 62; bo = seg(P, SHOT0 - .02, SHOT0); }
      if (sp >= 0 && sp < .50) {
        const p0 = holdPos(0, handX, floorY - F.sh.s * 62);
        const p1 = holdPos(sp, p0.x, p0.y);
        bx = p1.x; by = p1.y;
      } else if (sp >= .50) {
        const rel = holdPos(.5, handX, floorY);
        if (sp < .80) {
          const t = (sp - .5) / .3, u = 1 - t;
          const cx = lerp(rel.x, RIM.x, .45), cy = Math.min(rel.y, RIM.y) - 175;
          bx = u * u * rel.x + 2 * u * t * cx + t * t * RIM.x;
          by = u * u * rel.y + 2 * u * t * cy + t * t * RIM.y;
          bs = 1.15 * (1 - .22 * t);
        } else {
          bs = 1.15 * .78;
          if (sp < .88) { const u = (sp - .80) / .08; bx = RIM.x; by = RIM.y + 96 * u * u; }
          else {
            const u = clamp((sp - .88) / .12), n = u * 2.4, k = Math.floor(n), f = n - k;
            const h = [38, 15, 5][Math.min(k, 2)] * 4 * f * (1 - f) * 1;
            bx = RIM.x + 34 * u; by = 458 - h;
            bo = 1 - seg(u, .85, 1);
          }
        }
      }
      tf(el.ball, `translate(${bx.toFixed(2)} ${by.toFixed(2)}) scale(${bs.toFixed(3)})`);
      op(el.ball, bo);

      // red, aro y destello al entrar
      const sw = Math.sin(Math.PI * clamp((sp - .78) / .16));
      tf(el.net, `translate(620 364) scale(1 ${(1 + .22 * sw).toFixed(3)}) translate(-620 -364)`);
      const shake = Math.sin(clamp((sp - .78) / .16) * 28) * (1 - clamp((sp - .78) / .16)) * (sp > .78 ? 1 : 0);
      tf(el.rim, `translate(0 ${(1.6 * shake).toFixed(2)})`);
      op(el.hoopGlow, sw * .32);

      // reacción del público: saltito de la grada y flashes de cámara
      const env = seg(P, SHOT0 + .8 * SHOT_LEN, SHOT0 + .86 * SHOT_LEN) * (1 - seg(P, .50, .60));
      tf(el.crowd, `translate(0 ${(-3.5 * env * Math.abs(Math.sin(T * 7))).toFixed(2)})`);
      el.flashes.forEach((fl, i) => op(fl, Math.pow(Math.max(0, Math.sin(T * 9 + i * 7.3)), 8) * env));

      // ── videomarcador (con "pop" del dígito) y móvil de la grada
      op(el.boardPost, seg(P, .70, .72));
      const pop = 1 + .28 * bump(P, .715, .02);
      tf(el.pop, `translate(256 420) scale(${pop.toFixed(3)}) translate(-256 -420)`);
      op(el.boardFlash, bump(P, .71, .02) * .3);
      op(el.phoneJug, seg(P, .765, .78));
      op(el.phoneMap, seg(P, .795, .805));
      op(el.mapCover, 1 - seg(P, .805, .81));
      const rg = clamp((P - .805) / .035);
      op(el.mapRing, rg > 0 && rg < 1 ? (1 - rg) * .9 : 0);
      el.mapRing.style.transform = `scale(${(1 + rg * 1.8).toFixed(3)})`;
      op(el.phoneCro, seg(P, .835, .845));
      const row = seg(P, .845, .86);
      op(el.phoneRow, row); tf(el.phoneRow, `translate(0 ${(-8 * (1 - row)).toFixed(2)})`);
      txt(el.phoneScore, P >= .70 ? '2' : '0');

      // ── reloj: parado hasta empezar, luego cuenta atrás en todas las pantallas
      const runClock = P >= .195;
      const left = 600 - (runClock ? Math.floor((P - .195) * 14) : 0);
      const clk = `${String(Math.floor(left / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`;
      if (clk !== lastClock) { lastClock = clk; [el.clockTab, el.clockWall, el.clockPhone, el.clockBug].forEach(e => txt(e, clk)); }
      txt(el.wallState, runClock ? 'EN JUEGO' : 'RELOJ PARADO');

      // pie de escena
      let idx = 0; BOUNDS.forEach((b, i) => { if (P >= b) idx = i; });
      caps.forEach((cp, i) => cp.classList.toggle('is-active', i === idx));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
    }

    if (reduced) {
      root.classList.add('is-static');
      render(0, 0);
    } else {
      root.classList.add('is-live');
      let target = 0, cur = 0, visible = true, raf = 0, last = performance.now(), lastRender = 0, paused = false;
      const progress = () => {
        const r = track.getBoundingClientRect();
        const top = parseFloat(getComputedStyle(sticky).top) || 0;
        return clamp((top - r.top) / Math.max(1, r.height - sticky.offsetHeight));
      };
      // el progreso se suaviza para dar inercia a la cámara. En reposo solo se repinta a 15 fps (respiración de los jugadores)
      const loop = (now: number) => {
        raf = 0;
        if (paused) return;
        const dt = Math.min(.05, (now - last) / 1000); last = now;
        target = progress();
        const moving = Math.abs(target - cur) > 1e-4;
        const idleAnim = cur < .6 && now - lastRender > 83; // respiración de jugadores solo mientras se ven (12 fps)
        if (moving || idleAnim) {
          cur += (target - cur) * (1 - Math.exp(-dt * 13));
          if (!moving) cur = target;
          render(cur, now / 1000); lastRender = now;
        }
        if (visible) raf = requestAnimationFrame(loop);
      };
      const start = () => { if (!raf && !paused) { last = performance.now(); raf = requestAnimationFrame(loop); } };
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }, { rootMargin: '200px 0px' }).observe(track);
      cur = target = progress();
      render(cur, 0);
      start();
      // Depuración: ?tour-debug permite fijar el progreso (window.__tourSet(p)) sin bucle de animación
      if (location.search.includes('tour-debug')) {
        (window as any).__tourSet = (p: number, t = 1) => { paused = true; cancelAnimationFrame(raf); raf = 0; render(p, t); };
      }
    }
  }
</script>
