---
import Layout from '../components/Layout.astro';
import { works } from '../data/works.js';
import { projects } from '../data/projects.js';
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trabajos — Walid Sardi · Diseño y desarrollo web</title>
  <meta name="description" content="Trabajos freelance de Walid Sardi Boukhari: webs a medida para restaurantes, barberías y marcas en Zaragoza. Tacos Street, ZazaStop y más." />
  <meta name="author" content="Walid Sardi Boukhari" />
  <link rel="canonical" href="https://walidsardib.es/trabajos" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>

<Layout>
  <!-- ═══ HERO ═══ -->
  <section class="trabajos-hero">
    <div class="container">
      <p class="trabajos-eyebrow reveal-up">Trabajos · Freelance</p>
      <h1 class="trabajos-title reveal-up">Webs hechas a medida.</h1>
      <p class="trabajos-lead reveal-up">
        Diseño y desarrollo páginas web para negocios reales —restaurantes, barberías y marcas locales—
        cuidando cada detalle: rendimiento, diseño y resultados. Estos son algunos de mis trabajos.
      </p>
      <div class="incluido-strip reveal-up">
        <span class="incluido-label">Llave en mano</span>
        <span class="incluido-pill">Diseño</span>
        <span class="incluido-pill">Desarrollo</span>
        <span class="incluido-pill">Dominio</span>
        <span class="incluido-pill">Hosting</span>
        <span class="incluido-pill">SEO</span>
        <span class="incluido-pill">Mantenimiento</span>
      </div>
    </div>
  </section>

  <!-- ═══ WEBS PARA CLIENTES ═══ -->
  <section class="section" style="padding-top: 48px;">
    <div class="container">
      <h2 class="works-subtitle reveal-up">Webs para clientes</h2>
      <div class="works-grid">
        {works.map((w, i) => (
          <a
            href={w.caseStudy || w.live}
            target={w.caseStudy ? undefined : '_blank'}
            rel={w.caseStudy ? undefined : 'noopener'}
            class={`work-card reveal-up ${i % 2 === 0 ? 'r-left' : 'r-right'}${w.featured ? ' featured' : ''}`}
          >
            <div class="work-card-media">
              <img src={w.img} alt={`Web de ${w.title}`} loading="lazy" />
              {w.featured && <span class="work-badge">Caso de éxito</span>}
            </div>
            <div class="work-card-body">
              <div class="work-card-head">
                <h2 class="work-card-title">{w.title}</h2>
                <span class="work-card-tagline">{w.tagline} · {w.year}</span>
              </div>
              <p class="work-card-desc">{w.desc}</p>
              <div class="work-card-tech">
                {w.tech.map(t => (<span class="tech-pill">{t}</span>))}
              </div>
              <span class="work-card-link">
                {w.caseStudy ? 'Ver caso de estudio' : 'Visitar web'}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="works-subtitle reveal-up" style="margin-top: 72px;">Desarrollo a medida</h2>
      <p class="section-intro reveal-up">No solo webs de presentación. También construyo aplicaciones completas desde cero —este es mi proyecto personal más ambicioso.</p>

      {projects.map(p => (
        <a href={`/projects/${p.slug}`} class="work-card featured reveal-up r-scale">
          <div class="work-card-media">
            <div class="project-slideshow" data-interval="3500">
              <img class="slide active" src="/assets/competiciones.png" alt={`${p.title} imagen 1`} loading="lazy" />
              <img class="slide" src="/assets/directo.png" alt={`${p.title} imagen 2`} loading="lazy" />
            </div>
            <span class="work-badge">Proyecto a medida</span>
          </div>
          <div class="work-card-body">
            <div class="work-card-head">
              <h2 class="work-card-title">{p.title}</h2>
              <span class="work-card-tagline">Trabajo de Fin de Grado · Proyecto personal</span>
            </div>
            <p class="work-card-desc">{p.desc}</p>
            <div class="work-card-tech">
              {p.tech.map(t => (<span class="tech-pill">{t}</span>))}
            </div>
            <span class="work-card-link">
              Ver caso de estudio
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="section">
    <div class="container">
      <div class="contact-cta reveal-up" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 64px 40px; text-align: center; position: relative; overflow: hidden;">
        <div style="position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle at 50% 0%, var(--accent-glow) 0%, transparent 50%); pointer-events: none;"></div>
        <h3 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; color: var(--text); margin-bottom: 20px; letter-spacing: -0.01em;">
          ¿Tienes un negocio y necesitas <span class="gradient-text">web</span>?
        </h3>
        <p style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6; max-width: 560px; margin: 0 auto 36px;">
          Cuéntame tu idea y te propongo una web a medida, rápida y lista para vender. Sin plantillas, sin complicaciones.
        </p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a class="btn btn-primary" href="mailto:walidsardib@gmail.com" style="padding: 12px 24px; font-size: 1rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Pedir presupuesto
          </a>
          <a class="btn btn-secondary" href="/" style="padding: 12px 24px; font-size: 1rem;">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
