---
import Layout from '../../components/Layout.astro';
import '../../home.css';
import '../../case.css';

// Secciones de la web que se recorren dentro del navegador (orden de la tira)
const shots = [
  { src: '/assets/work/tacos-hero.webp', h: 800, label: 'Portada', alt: 'Portada de la web de Tacos Street' },
  { src: '/assets/work/tacos-crea.webp', h: 604, label: 'Crea tu taco', alt: 'Configurador Crea tu taco' },
  { src: '/assets/work/tacos-productos.webp', h: 587, label: 'La carta', alt: 'Carta de productos de Tacos Street' }
];
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Tacos Street — Caso de estudio · Walid Sardi</title>
  <meta name="description" content="Caso de estudio: web de marca para Tacos Street, the original french tacos en Zaragoza. Astro, TypeScript, animaciones y carta interactiva. Por Walid Sardi Boukhari." />
  <meta name="author" content="Walid Sardi Boukhari" />
  <link rel="canonical" href="https://walidsardib.es/projects/tacosstreet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <meta name="theme-color" content="#f0531c" />
  <meta property="og:image" content="https://walidsardib.es/assets/work/tacos-hero.jpeg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://walidsardib.es/assets/work/tacos-hero.jpeg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<Layout>
  <!-- ═══ HERO ═══ -->
  <section class="c-hero">
    <div class="container">
      <a href="/servicios" class="c-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Servicios
      </a>
      <p class="c-meta reveal-up">Caso de éxito · Web de marca · 2026</p>
      <h1 class="c-title">
        <span class="h-word"><span>Tacos</span></span>
        <span class="h-word"><span>Street<span class="c-dot">.</span></span></span>
      </h1>
      <p class="c-lead reveal-up">
        The Original French Tacos en Zaragoza. Una web de marca con carácter: rápida, animada
        y pensada para convertir el hambre en pedidos.
      </p>
      <div class="h-ctas reveal-up">
        <a class="h-btn h-btn-solid" href="https://tacosstreet.es" target="_blank" rel="noopener">Ver web en vivo
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
        <a class="h-btn h-btn-ghost" href="#recorrido">Recorrer la web</a>
      </div>
    </div>
  </section>

  <!-- ═══ RECORRIDO: la web se desplaza dentro del navegador al hacer scroll ═══ -->
  <section class="c-tour" id="recorrido">
    <div class="c-tour-sticky">
      <div class="container c-tour-grid">
        <ol class="c-tour-labels" aria-label="Secciones de la web">
          {shots.map((s, i) => (
            <li class="c-tour-label" style={`--n:${i}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>{s.label}
            </li>
          ))}
        </ol>
        <div class="c-browser">
          <div class="c-browser-bar"><span></span><span></span><span></span><em>tacosstreet.es</em></div>
          <div class="c-browser-view">
            <div class="c-strip">
              {shots.map(s => (<img src={s.src} srcset={`${s.src.replace('.webp','-sm.webp')} 760w, ${s.src} 1280w`} sizes="(max-width: 900px) 92vw, 860px" width="1280" height={s.h} alt={s.alt} loading="lazy" />))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ MÉTRICAS (cuentan hacia arriba al aparecer) ═══ -->
  <section class="container">
    <dl class="c-stats">
      <div class="reveal-up"><dt>Posición en Google por "tacos street"</dt><dd>Nº <span data-count="1">1</span></dd></div>
      <div class="reveal-up"><dt>Clics orgánicos · 28 días (+79%)</dt><dd><span data-count="1.12" data-decimals="2">1,12</span> mil</dd></div>
      <div class="reveal-up"><dt>Impresiones · 28 días (+75%)</dt><dd><span data-count="13.9" data-decimals="1">13,9</span> mil</dd></div>
      <div class="reveal-up"><dt>Tiempo hasta el primer puesto</dt><dd>&lt; <span data-count="1">1</span> mes</dd></div>
    </dl>
  </section>

  <!-- ═══ EL ENCARGO: las palabras se encienden al leer ═══ -->
  <section class="h-section c-brief">
    <div class="container">
      <h2 class="c-h2 reveal-up">El encargo</h2>
      <p class="c-words" data-words>
        Tacos Street no quería una web más de restaurante. Querían trasladar la energía de su marca urbana, street,
        atrevida y con identidad propia, a una página que se sintiera viva nada más entrar.
      </p>
      <p class="c-note reveal-up">
        El reto: una experiencia <strong>moderna y con animación</strong>, pero rápida y ligera,
        que funcionara igual de bien en el móvil de alguien con hambre a las 2 de la madrugada.
      </p>
    </div>
  </section>

  <!-- ═══ CARACTERÍSTICAS: la captura se abre con el scroll ═══ -->
  <section class="h-section">
    <div class="container c-features">
      <article class="c-feature">
        <div class="c-feature-media"><img src="/assets/work/tacos-crea.webp" srcset="/assets/work/tacos-crea-sm.webp 760w, /assets/work/tacos-crea.webp 1280w" sizes="(max-width: 900px) 92vw, 620px" width="1280" height="604" alt="Configurador interactivo Crea tu taco" loading="lazy" /></div>
        <div class="c-feature-text reveal-up">
          <h2 class="c-h2">Crea tu taco</h2>
          <p>
            El corazón interactivo de la web: un <strong>configurador "crea tu taco"</strong> donde el cliente
            elige tamaño, carnes y salsas y ve el precio actualizarse al momento.
          </p>
          <p>
            Pequeñas animaciones y microinteracciones hacen que pedir sea casi tan divertido como comer,
            sin sacrificar velocidad ni accesibilidad.
          </p>
        </div>
      </article>

      <article class="c-feature c-feature-rev">
        <div class="c-feature-media"><img src="/assets/work/tacos-productos.webp" srcset="/assets/work/tacos-productos-sm.webp 760w, /assets/work/tacos-productos.webp 1280w" sizes="(max-width: 900px) 92vw, 620px" width="1280" height="587" alt="Sección de productos de la carta de Tacos Street" loading="lazy" /></div>
        <div class="c-feature-text reveal-up">
          <h2 class="c-h2">Una carta que da hambre</h2>
          <p>
            Los productos se presentan con fotografía cuidada, filtros por categoría e información clara
            de alérgenos. Todo organizado para que encontrar tu pedido sea inmediato.
          </p>
          <p>
            La web conecta directamente con <strong>Uber Eats y Glovo</strong>, así que el camino del antojo
            al pedido es de un solo clic.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- ═══ RESULTADO ═══ -->
  <section class="h-section c-result">
    <div class="container c-result-grid">
      <p class="c-big" aria-hidden="true">Nº1</p>
      <div class="reveal-up">
        <h2 class="c-h2">Primera en Google. Sin gastar un euro en publicidad.</h2>
        <p>
          Lo más importante de una web no es cómo se ve, sino que la <strong>encuentren</strong>. Tacos Street
          se lanzó <strong>sin ninguna promoción</strong>: nada de redes sociales, nada de anuncios pagados.
          Solo una web bien construida y optimizada para SEO desde el primer día.
        </p>
        <p>
          En <strong>menos de un mes</strong> ya aparecía en el <strong>primer puesto</strong> de Google al buscar
          "tacos street", superando en resultados orgánicos a gigantes como <strong>Uber Eats y Glovo</strong>.
          Hoy supera los <strong>1.000 clics</strong> y las <strong>13.000 impresiones</strong> cada 28 días:
          tráfico real que se traduce en clientes que entran por la puerta.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ TECNOLOGÍA + CTA ═══ -->
  <section class="h-section">
    <div class="container c-end">
      <div class="reveal-up">
        <h2 class="c-h2">Tecnología</h2>
        <p class="c-note">
          Construida con <strong>Astro</strong> y <strong>TypeScript</strong> para una web estática ultrarrápida,
          con CSS a medida y animaciones nativas. Cero peso innecesario: máxima velocidad y buen SEO.
        </p>
        <ul class="proj-tags">
          <li>Astro</li><li>TypeScript</li><li>CSS</li><li>Animaciones</li><li>SEO</li><li>Responsive</li>
        </ul>
      </div>
      <div class="c-cta reveal-up">
        <h2>¿Quieres una web así para tu negocio?</h2>
        <p>Te propongo una web a medida con la misma atención al detalle.</p>
        <div class="h-ctas">
          <a class="h-btn h-btn-solid" href="/#contacto">Pedir presupuesto</a>
          <a class="h-btn h-btn-ghost" href="/servicios">Ver más trabajos</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
</html>
